[Desktop Entry]
Type=Application
Name=Open with @DISPLAY_NAME@
Comment=Align and focus-stack selected photos
Exec=@GUI_BINARY@ %F
TryExec=@GUI_BINARY@
Terminal=false
Categories=Graphics;Photography;
MimeType=image/tiff;image/png;image/jpeg;image/x-adobe-dng;image/x-canon-cr2;image/x-canon-cr3;image/x-nikon-nef;image/x-sony-arw;image/x-fuji-raf;image/x-panasonic-rw2;image/x-pentax-pef;image/x-olympus-orf;
StartupNotify=true
